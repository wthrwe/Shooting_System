/**
  ******************************************************************************
  * @file    AVE_secrets.h.example
  * @brief   凭据模板 —— **入库的是这一个**，真实凭据文件不进版本库
  *
  *  ── 用法 ───────────────────────────────────────────────────────────────────
  *  1. 把本文件复制为同目录下的 `AVE_secrets.h`（去掉 `.example`）
  *  2. 把下面的字段填成真实值
  *  3. 确认 `AVE_secrets.h` 已在版本控制忽略清单里
  *
  *  🔴 **`AVE_secrets.h` 含明文凭据，禁止外传、禁止提交。**
  *     本模板文件里**只有字段名和空值** —— 保持这样。
  *     任何时候都不要把真实热点名、密码、服务器地址写进本文件或任何文档。
  *
  *  ⚠️ 只有 `AVE_ENABLE_CLOUD = 1`（见 AVE_tuning.h）时这个文件才会被包含。
  *     默认是 0，所以**没有它也能正常编译** —— 这是有意的。
  ******************************************************************************
  */

#ifndef AVE_SECRETS_H
#define AVE_SECRETS_H

/* ── 无线热点 ────────────────────────────────────────────────────────────── */
#define AVE_WIFI_SSID                   ""
#define AVE_WIFI_PASSWORD               ""

/* ── 消息服务器 ──────────────────────────────────────────────────────────── */
#define AVE_MQTT_HOST                   ""
#define AVE_MQTT_PORT                   1883
#define AVE_MQTT_USER                   ""
#define AVE_MQTT_PASSWORD               ""

/* ── 客户端标识 ──────────────────────────────────────────────────────────── */
#define AVE_MQTT_CLIENT_ID              ""

/* ── 主题 ────────────────────────────────────────────────────────────────── */
#define AVE_MQTT_TOPIC_CMD              ""
#define AVE_MQTT_TOPIC_STATUS           ""

#endif /* AVE_SECRETS_H */
